{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MongoDB AST Validation Schema",
  "type": "object",
  "properties": {
    "required_methods": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "enum": ["createCollection", "validator", "$jsonSchema"] }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "enum": ["insertOne without validation"] }
    },
    "forbidden_types": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "enum": ["any"] }
    },
    "required_imports": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "enum": ["@features", "@entities", "@shared", "@domain"] }
    }
  }
}
